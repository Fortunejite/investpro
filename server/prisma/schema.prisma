generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum userStatus {
  active
  inactive
  banned
}

enum Chain {
  eth
  bsc
  polygon
  sol
}

enum TransactionType {
  deposit
  withdrawal
  investment
  profit_payout
}

enum TransactionStatus {
  pending
  approved
  rejected
  cancelled
}

enum PayoutType {
  daily
  weekly
  monthly
  end_of_term
}

enum InvestmentStatus {
  active
  inactive
  expired
  cancelled
}

model User {
  id                  Int        @id @default(autoincrement())
  email               String     @unique
  name                String
  hashed_password     String
  role                Role       @default(user)
  status              userStatus @default(active)
  forgetPasswordToken String?    @unique
  resetTokenExpiry    DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  assets  Assets[]
  account Account?

  @@map("users")
}

model Account {
  id Int @id @unique

  availableBalance Decimal @default(0) @db.Decimal(18, 8)
  lockedBalance    Decimal @default(0) @db.Decimal(18, 8)

  updatedAt        DateTime  @updatedAt
  lastDepositAt    DateTime?
  lastWithdrawalAt DateTime?

  user         User          @relation(fields: [id], references: [id])
  deposits     Deposit[]
  withdrawals  Withdrawal[]
  transactions Transaction[]
  investments  Investment[]

  @@map("accounts")
}

model Assets {
  id     String  @id @default(uuid())
  userId Int
  chain  Chain
  label  String?

  availableBalance Decimal @default(0) @db.Decimal(18, 8)
  lockedBalance    Decimal @default(0) @db.Decimal(18, 8)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, chain])
  @@map("assets")
}

model Deposit {
  id         String            @id @default(uuid())
  accountId  Int
  chain      Chain
  perUsdRate Decimal           @db.Decimal(18, 8)
  amount     Decimal           @db.Decimal(18, 8)
  txHash     String?           @unique
  proofUrl   String?
  status     TransactionStatus @default(pending)
  adminNote  String?
  createdAt  DateTime          @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@map("deposits")
}

model Withdrawal {
  id                 String            @id @default(uuid())
  accountId          Int
  chain              Chain
  perUsdRate         Decimal           @db.Decimal(18, 8)
  amount             Decimal           @db.Decimal(18, 8)
  destinationAddress String
  status             TransactionStatus @default(pending)
  adminNote          String?
  createdAt          DateTime          @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@map("withdrawals")
}

model Transaction {
  id                 String          @id @default(uuid())
  accountId          Int
  type               TransactionType
  amount             Decimal         @db.Decimal(18, 8)
  actionId           String
  txHash             String?         @unique
  destinationAddress String?
  createdAt          DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@map("transactions")
}

model InvestmentPlan {
  id             Int        @id @default(autoincrement())
  name           String
  description    String?
  minAmount      Int
  durationInDays Int
  roiPercent     Int
  payoutType     PayoutType
  isActive       Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investments Investment[]

  @@map("plans")
}

model Investment {
  id        String           @id @default(uuid())
  accountId Int
  planId    Int
  amount    Decimal          @db.Decimal(18, 8)
  profit    Decimal          @db.Decimal(18, 8)
  startDate DateTime
  endDate   DateTime
  status    InvestmentStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account        @relation(fields: [accountId], references: [id])
  plan    InvestmentPlan @relation(fields: [planId], references: [id])

  @@map("investments")
}
