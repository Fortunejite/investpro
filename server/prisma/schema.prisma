generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  trader
  admin
}

enum userStatus {
  active
  inactive
  banned
}

enum Chain {
  eth
  bsc
  btc
  sol
}

enum TransactionType {
  deposit
  withdrawal
  withdrawal_cancellation
  withdrawal_rejected
  investment
  profit_payout
  signal_subscription
}

enum TransactionStatus {
  pending
  approved
  rejected
  cancelled
}

enum PayoutType {
  daily
  weekly
  monthly
  end_of_term
}

enum InvestmentStatus {
  active
  inactive
  expired
  cancelled
}

enum TradeSignalPlan {
  monthly
  quarterly
  yearly
}

enum TradeSignalAction {
  Buy
  Sell
}

enum TradeSignalStatus {
  published
}

enum TradeSignalDeliveryStatus {
  queued
  sent
  failed
}

model User {
  id                  Int        @id @default(autoincrement())
  email               String     @unique
  name                String
  hashed_password     String
  role                Role       @default(user)
  status              userStatus @default(active)
  forgetPasswordToken String?    @unique
  resetTokenExpiry    DateTime?
  telegramUserId      String?
  refreshToken        String?    @unique
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  assets                  Asset[]
  account                 Account?
  signalDeliveries        TradeSignalDeliveries[]
  tradeSignalSubscription TradeSignalSubscription?
  swaps                   Swap[]
  tradingProfile          TradingProfile?

  @@map("users")
}

model TradingProfile {
  id                 Int      @id
  bio                String?
  profitSharePercent Decimal  @default(0) @db.Decimal(5, 2)
  totalProfit        Decimal  @default(0) @db.Decimal(18, 8)
  winRate            Decimal  @default(0) @db.Decimal(5, 2)
  totalTrades        Int      @default(0)
  successfulTrades   Int      @default(0)
  minCapital         Decimal  @default(0) @db.Decimal(18, 8)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user      User             @relation(fields: [id], references: [id])
  followers TraderFollower[]

  @@map("trading_profiles")
}

model TraderFollower {
  id        Int      @id @default(autoincrement())
  traderId  Int
  userId    Int
  createdAt DateTime @default(now())

  trader TradingProfile @relation(fields: [traderId], references: [id])

  @@unique([traderId, userId])
  @@map("trader_followers")
}

model Account {
  id Int @id @unique

  availableBalance Decimal @default(0) @db.Decimal(18, 8)
  lockedBalance    Decimal @default(0) @db.Decimal(18, 8)

  updatedAt        DateTime  @updatedAt
  lastDepositAt    DateTime?
  lastWithdrawalAt DateTime?

  user         User          @relation(fields: [id], references: [id])
  deposits     Deposit[]
  withdrawals  Withdrawal[]
  transactions Transaction[]
  investments  Investment[]

  @@map("accounts")
}

model Coin {
  id        String   @id
  symbol    String
  name      String
  nameId    String
  img       String
  rank      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]

  @@map("coins")
}

model Asset {
  id     Int    @id @default(autoincrement())
  userId Int
  coinId String

  availableBalance Decimal @default(0) @db.Decimal(18, 8)
  lockedBalance    Decimal @default(0) @db.Decimal(18, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id])
  coin      Coin   @relation(fields: [coinId], references: [id])
  swapsFrom Swap[] @relation("FromAsset")
  swapsTo   Swap[] @relation("ToAsset")

  @@unique([userId, coinId])
  @@map("assets")
}

model Swap {
  id           String   @id @default(uuid())
  userId       Int
  fromAssetId  Int // account for main account
  toAssetId    Int // account for main account
  amount       Decimal  @db.Decimal(18, 8)
  exchangeRate Decimal  @db.Decimal(18, 8)
  createdAt    DateTime @default(now())

  user      User  @relation(fields: [userId], references: [id])
  fromAsset Asset @relation("FromAsset", fields: [fromAssetId], references: [id])
  toAsset   Asset @relation("ToAsset", fields: [toAssetId], references: [id])

  @@map("swaps")
}

model Deposit {
  id         String            @id @default(uuid())
  accountId  Int
  chain      Chain
  perUsdRate Decimal           @db.Decimal(18, 8)
  amount     Decimal           @db.Decimal(18, 8)
  txHash     String?           @unique
  proofUrl   String?
  status     TransactionStatus @default(pending)
  adminNote  String?
  createdAt  DateTime          @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@map("deposits")
}

model Withdrawal {
  id                 String            @id @default(uuid())
  accountId          Int
  chain              Chain
  perUsdRate         Decimal           @db.Decimal(18, 8)
  amount             Decimal           @db.Decimal(18, 8)
  destinationAddress String
  status             TransactionStatus @default(pending)
  adminNote          String?
  createdAt          DateTime          @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@map("withdrawals")
}

model Transaction {
  id                 String          @id @default(uuid())
  accountId          Int
  type               TransactionType
  amount             Decimal         @db.Decimal(18, 8)
  actionId           String?
  txHash             String?         @unique
  destinationAddress String?
  createdAt          DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@map("transactions")
}

model InvestmentPlan {
  id             Int        @id @default(autoincrement())
  name           String
  description    String?
  minAmount      Int
  durationInDays Int
  roiPercent     Int
  payoutType     PayoutType
  isActive       Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investments Investment[]

  @@map("plans")
}

model Investment {
  id        String           @id @default(uuid())
  accountId Int
  planId    Int
  amount    Decimal          @db.Decimal(18, 8)
  profit    Decimal          @db.Decimal(18, 8)
  startDate DateTime
  endDate   DateTime
  status    InvestmentStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account        @relation(fields: [accountId], references: [id])
  plan    InvestmentPlan @relation(fields: [planId], references: [id])

  @@map("investments")
}

model TradeSignal {
  id Int @id @default(autoincrement())

  action     TradeSignalAction
  currency   String
  entryPrice Decimal           @db.Decimal(18, 8)
  tp1        Decimal           @db.Decimal(18, 8)
  tp2        Decimal?          @db.Decimal(18, 8)
  sl         Decimal           @db.Decimal(18, 8)

  status TradeSignalStatus @default(published)

  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  deliveries TradeSignalDeliveries[]

  @@map("trade_signals")
}

model TradeSignalDeliveries {
  id             String                    @id @default(uuid())
  signalId       Int
  userId         Int
  telegramUserId String
  status         TradeSignalDeliveryStatus @default(queued)
  error          String?
  attempts       Int                       @default(0)
  lastAttempt    DateTime?
  createdAt      DateTime                  @default(now())

  signal TradeSignal @relation(fields: [signalId], references: [id])
  user   User        @relation(fields: [userId], references: [id])

  @@map("trade_signal_deliveries")
}

model TradeSignalSubscription {
  id        Int             @id @default(autoincrement())
  userId    Int             @unique
  plan      TradeSignalPlan
  amount    Decimal         @db.Decimal(18, 8)
  isActive  Boolean         @default(true)
  startedAt DateTime        @default(now())
  endedAt   DateTime

  user User @relation(fields: [userId], references: [id])

  @@map("trade_signal_subscriptions")
}

model Settings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
